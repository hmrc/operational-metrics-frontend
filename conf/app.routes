# microservice specific routes

->          /catalogue-wrapper                           cataloguewrapper.Routes

GET         /                                            controllers.IndexController.onPageLoad()

GET         /assets/*file                                controllers.Assets.versioned(path="/public", file: Asset)

GET         /auth/sign-in                                controllers.auth.AuthController.signIn(targetUrl: Option[RedirectUrl])
GET         /auth/post-sign-in                           controllers.auth.AuthController.postSignIn(targetUrl: Option[RedirectUrl])

GET         /account/sign-out                            controllers.auth.AuthController.signOut()
GET         /account/signed-out                          controllers.auth.SignedOutController.onPageLoad()
